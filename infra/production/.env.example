# Non-secret deployment coordinates. Copy to .env.local on the server.
COMPOSE_PROJECT_NAME=dimax-production

# Both images must be immutable: sha256 digest or a tag ending in the source SHA.
DIMAX_BACKEND_IMAGE=ghcr.io/your-organization/dimax-backend:git-000000000000
DIMAX_ADMIN_IMAGE=ghcr.io/your-organization/dimax-admin:git-000000000000

# Keep the real backend env outside the repository with mode 0600.
DIMAX_BACKEND_ENV_FILE=/opt/dimax/secrets/backend.env
DIMAX_CADDYFILE=/opt/dimax/app/infra/production/Caddyfile

DIMAX_API_HOST=api.your-domain.example
DIMAX_ADMIN_HOST=ops.your-domain.example
DIMAX_TLS_EMAIL=owner@your-domain.example

# The API stays private to the VM; Caddy reaches it over the Compose network.
DIMAX_API_BIND=127.0.0.1:8000
DIMAX_WEB_CONCURRENCY=2

